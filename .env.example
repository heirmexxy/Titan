PORT=4600
PUBLIC_URL=https://titan.kitovu.com.ng
DATABASE_URL=postgres://titan:CHANGE_ME@127.0.0.1:5432/titan
# Shared secret EMQX sends in the X-Titan-Internal header
TITAN_INTERNAL_SECRET=CHANGE_ME_LONG_RANDOM
MQTT_PUBLIC_HOST=mqtt.titan.kitovu.com.ng
MQTT_PUBLIC_PORT=8883
EMQX_API_URL=http://127.0.0.1:18083/api/v5
EMQX_API_KEY=
EMQX_API_SECRET=
RESEND_API_KEY=
RESEND_FROM="Titan <alerts@titan.kitovu.com.ng>"
DEMO_INBOX=titan@kitovu.com.ng
TERMII_API_KEY=
TERMII_SENDER_ID=Titan
PAYSTACK_SECRET_KEY=
OFFLINE_SWEEP_SECONDS=30
# Optional: lets the ops agent write customer messages and report summaries with Claude (templates are used without it)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
