{
  "name": "Titan Field",
  "short_name": "Titan",
  "description": "Titan in the field: site status, alerts, device installation, produce quality tests and lot tracking. Works offline.",
  "id": "/app/",
  "start_url": "/app/",
  "scope": "/app/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#EEF2F0",
  "theme_color": "#14213D",
  "categories": ["business", "productivity", "utilities"],
  "icons": [
    { "src": "/app/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/app/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/app/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/app/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "New quality test", "url": "/app/#test", "icons": [{ "src": "/app/icon-192.png", "sizes": "192x192" }] },
    { "name": "Install a device", "url": "/app/#install", "icons": [{ "src": "/app/icon-192.png", "sizes": "192x192" }] }
  ]
}
